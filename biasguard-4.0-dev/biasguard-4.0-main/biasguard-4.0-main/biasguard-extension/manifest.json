{
  "manifest_version": 3,
  "name": "BiasGuard - Real-time Bias Detection",
  "version": "1.0.0",
  "description": "Detect and fix bias in your writing across the web. Works on Gmail, social media, Google Docs, and more.",
  "author": "BiasGuard Team",
  
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "cookies"
  ],
  
  "host_permissions": [
    "https://*/*",
    "https://biasguard.vercel.app/*",
    "https://*.vercel.app/*",
    "https://biasguard.com/*",
    "https://*.biasguard.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  
  "background": {
    "service_worker": "background/background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/api.js", "lib/privacy.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BiasGuard - Check for Bias",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png", 
    "128": "assets/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "content/content.css", "privacy.html"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

